# Nusxa oling: cp .env.example .env  (.env git ga tushmaydi)

# Markaziy PostgreSQL. O'rnatilmasa — loyiha papkasidagi lokal
# vibration.db (SQLite) ishlatiladi (konsolda qaysi baza ekani yoziladi).
# DATABASE_URL=postgresql+psycopg://user:parol@host:5432/vibration

# API himoyasi: serverni tarmoqqa ochishdan oldin (uvicorn --host 0.0.0.0)
# ikkala mashinada BIR XIL API_KEY o'rnating va portni faqat ichki
# tarmoq/firewall darajasida cheklang.
# API_KEY=

# Telegram xabarlari (ikkalasi bo'sh bo'lsa — xabar yuborilmaydi).
# Avval ESKI botni @BotFather da /revoke qilib bekor qiling, keyin
# yangi token oling.
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# Kollektor (datchik mashinasi) sozlamalari
# SERIAL_PORT=COM3
# API_URL=http://server-ip:8000/api/vibration
# BEARING_NAME=Bearing 4 (Motor)
